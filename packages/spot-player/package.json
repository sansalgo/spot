{
  "name": "@sansalgo/spot-player",
  "version": "0.3.0",
  "description": "Pixel animation player for React — no canvas, no heavy runtime",
  "keywords": [
    "pixel",
    "animation",
    "react",
    "component"
  ],
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
